@model BannerViewModel

@{
    var version = Model.Version;
    var bannerTokens = Model.Tokens;    
    var PriceUpdateInterval = Model.PriceUpdateInterval;
    var SecondsSinceLastPriceUpdate = Model.SecondsSinceLastPriceUpdate;
    var getValuesRoute = Url.RouteUrl(PluginDefaults.GetDynamicPriceValues);
    var cartLockCreateRoute = Url.RouteUrl(PluginDefaults.CreateCartLocks);
}

<!link rel="stylesheet" href="/Plugins/i7MEDIA.Plugin.Misc.Dynamic.Pricing/Areas/Public/styles/banner.css?v=@version" />

<!script type="module">
    import {init} from '/Plugins/i7MEDIA.Plugin.Misc.Dynamic.Pricing/Areas/Public/scripts/banner.js?v=@version';

    init({
        getRoute: '@getValuesRoute',
        cartLockCreateRoute: '@cartLockCreateRoute',
        secondsSinceLastUpdate : @SecondsSinceLastPriceUpdate,
        priceUpdateInterval: @PriceUpdateInterval,
        confirmMessage: '@T("public.dynamic.price.banner.confirm")',
        notificationUris: ['/checkout', '/simplecheckout']
    });
</!script>

<div data-dynamic-price-banner>
    @foreach (var token in bannerTokens)
    {
        <section data-metal-symbol="@token.Symbol">
            <span data-value-label>@T($"admin.dynamic.price.banner.label.{token.Symbol}", token.Symbol)</span>
            <span data-current>@token.Price.ToCurrency()</span>
            <span data-positive="@(token.Delta > 0)"></span>
            <span data-delta>@token.Delta.ToCurrency()</span>
        </section>
    }
    <section data-dynamic-price-timer hidden>
        <span>@T("admin.dynamic.price.banner.label.timer")</span><span data-timer>--:--</span>
    </section>
</div>
</div>