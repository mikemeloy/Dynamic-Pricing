@model BannerViewModel

@{
    var version = Model.Version;

    var goldValue = Model.GoldPrice;
    var goldDelta = Model.GoldDelta;
    var goldSymbol = Model.GoldSymbol;

    var silverValue = Model.SilverPrice;
    var silverSymbol = Model.SilverSymbol;
    var silverDelta = Model.SilverDelta;

    var platValue = Model.PlatinumPrice;
    var platSymbol = Model.PlatinumSymbol;
    var platDelta = Model.PlatinumDelta;

    var secondsSinceLastUpdate = Model.SecondsSinceLastPriceUpdate;
    var cartPriceLock = Model.CartPriceLock;
    var getValuesRoute = Url.RouteUrl(PluginDefaults.GetDynamicPriceValues);
    var priceUpdateInterval = Model.PriceUpdateInterval;
}

<!link rel="stylesheet" href="/Plugins/i7MEDIA.Plugin.Misc.Dynamic.Pricing/Areas/Public/styles/banner.css?v=@version" />
<!script type="module">
    import {init} from '/Plugins/i7MEDIA.Plugin.Misc.Dynamic.Pricing/Areas/Public/scripts/banner.js?v=@version';

    init({
        secondsSinceLastUpdate: @secondsSinceLastUpdate,
        cartPriceLock: @cartPriceLock,
        getRoute: '@getValuesRoute',
        priceUpdateInterval: @priceUpdateInterval
    });
</!script>
<div data-dynamic-price-banner>
    <section data-metal-symbol="@goldSymbol">
        <span data-value-label>@T("admin.dynamic.price.banner.span.gold")</span>
        <span data-current>@goldValue.ToCurrency()</span>
        <span data-positive="@(goldDelta > 0)"></span>
        <span data-delta>@goldDelta.ToCurrency()</span>
    </section>
    <section data-metal-symbol="@silverSymbol">
        <span data-value-label> @T("admin.dynamic.price.banner.span.silver")</span>
        <span data-current>@silverValue.ToCurrency()</span>
        <span data-positive="@(silverDelta > 0)"></span>
        <span data-delta>@silverDelta.ToCurrency()</span>
    </section>

    <section data-metal-symbol="@platSymbol">
        <span data-value-label> @T("admin.dynamic.price.banner.span.platinum")</span>
        <span data-current>@platValue.ToCurrency()</span>
        <span data-positive="@(platDelta > 0)"></span>
        <span data-delta>@platDelta.ToCurrency()</span>
    </section>





    <section data-dynamic-price-timer>
        <span>@T("admin.dynamic.price.banner.label.timer")</span><span data-timer>--:--</span>
    </section>
</div>