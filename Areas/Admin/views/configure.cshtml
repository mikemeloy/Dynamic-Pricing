@model ConfigureViewModel

@{
    Layout = "_ConfigurePlugin";

    var version = Model.Version;
    var saveRoute = Url.RouteUrl(Model.SaveRoute);
}

<!link rel="stylesheet" href="/Plugins/i7MEDIA.Plugin.Misc.Dynamic.Pricing/Areas/Admin/Styles/configure.css?v=@version" />
<!script type="module">
    import {init} from '/Plugins/i7MEDIA.Plugin.Misc.Dynamic.Pricing/Areas/Admin/Scripts/configure.js?v=@version';

    init({saveRoute: '@saveRoute'});
</!script>
<div data-container-configure>
    <main>
        <nop-label asp-for="WeightConversion" />
        <nop-editor asp-for="WeightConversion" />

        <nop-label asp-for="ApiKey" />
        <nop-editor asp-for="ApiKey" />

        <nop-label asp-for="ApiEndpoint" />
        <nop-editor asp-for="ApiEndpoint" />

        <nop-label asp-for="CartPriceLock" />
        <nop-editor asp-for="CartPriceLock" />
    </main>
    <footer data-actions>
        <button type="button" data-save class="btn btn-success">
            @T("admin.dynamic.price.save")
        </button>
    </footer>
    <div data-dynamic-price-file>
        <input type="file" value="Click" />
        <button type="button" data-dynamic-price-export>Export</button>
    </div>
</div>