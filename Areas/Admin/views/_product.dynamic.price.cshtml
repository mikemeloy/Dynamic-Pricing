@model AdminProductViewModel

@{
    var version = Model.Version;
    var productId = Model.ProductId;
    var saveRoute = Url.RouteUrl(PluginDefaults.SaveProductDynamicPrice);
    var selectedMetalType = Model.SelectedMetalType;
    var excluded = Model.Exclude;
}

<!link rel="stylesheet" href="/Plugins/i7MEDIA.Plugin.Misc.Dynamic.Pricing/Areas/Admin/Styles/product.css?v=@version" />
<!script type="module">
    import {init} from '/Plugins/i7MEDIA.Plugin.Misc.Dynamic.Pricing/Areas/Admin/Scripts/product.js?v=@version';

    init({
        selectedMetalType: @selectedMetalType,
        isExcluded: '@excluded',
        productId: '@productId',
        saveRoute: '@saveRoute',
        errorMessage : '@T("Admin.Dynamic.Price.Pattern.Button.Save")'
    });
</!script>

<nop-cards id="dynamic-price-cards">
    <nop-card>
        <div class="card card-secondary card-outline advanced-setting" data-card-name="dynamic-price" data-hideattribute="ProductPage.HideDynamicPriceBlock">
            <div class="card-header with-border clearfix">
                <div class="card-title"><i class="fas fa-dollar-sign"></i>@T("Admin.Dynamic.Price.Section.Label")</div>
                <div class="card-tools float-right"><button class="btn btn-tool" data-card-widget="collapse" type="button"><i class="fa toggle-icon fa-minus"></i></button></div>
            </div>
            <div class="card-body">
                <section class="form-group row">
                    <header class="col-md-3">
                        <nop-label asp-for="Exclude" />
                    </header>
                    <main class="col-md-9">
                        <input asp-for="Exclude" type="checkbox" />
                    </main>
                </section>
                <section class="form-group row">
                    <header class="col-md-3">
                        <nop-label asp-for="SelectedMetalType" />
                    </header>
                    <main class="col-md-9">
                        <nop-select asp-for="SelectedMetalType" asp-items="Model.AvailableMetalTypes" asp-multiple="false" />
                    </main>
                </section>
                <section class="form-group row">
                    <header class="col-md-3">
                        <nop-label asp-for="BasePrice" />
                    </header>
                    <main class="col-md-9">
                        <nop-editor asp-for="BasePrice" />
                    </main>
                </section>
                <section class="form-group row">
                    <header class="col-md-3">
                        <nop-label asp-for="Weight" />
                    </header>
                    <main class="col-md-9">
                        <nop-editor asp-for="Weight" />
                    </main>
                </section>
                <section class="form-group row">
                    <header class="col-md-3">
                        <nop-label asp-for="PriceModifierType" />
                    </header>
                    <main class="col-md-9">
                        <nop-select asp-for="PriceModifierType" asp-items="Model.PriceModifierTypes" asp-multiple="false" />
                    </main>
                </section>
                <section class="form-group row">
                    <header class="col-md-3">
                        <nop-label asp-for="PriceModifier" />
                    </header>
                    <main class="col-md-9">
                        <nop-editor asp-for="PriceModifier" />
                    </main>
                </section>
                <footer data-actions>
                    <button type="button" class="btn btn-success">
                        @T("Admin.Dynamic.Price.Save")
                    </button>
                </footer>
            </div>
        </div>
    </nop-card>
</nop-cards>
